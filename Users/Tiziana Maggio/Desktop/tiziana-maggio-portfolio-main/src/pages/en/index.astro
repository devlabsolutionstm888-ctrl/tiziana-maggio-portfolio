---
import Layout from '../../layouts/Layout.astro';
import ChatWidget from '../../components/ChatWidget.jsx';
import Navbar from '../../components/Navbar.jsx';
import ProjectsSection from '../../components/ProjectsSection.jsx';
import CvSection from '../../components/CvSection.jsx';
import { translations } from '../../i18n/translations.js';

const currentLang = 'en';
const t = translations[currentLang] || translations['it'];
---

<Layout title="Tiziana Maggio Dev | Full-Stack React Developer" lang={currentLang}>
  <Navbar currentLang={currentLang} t={t} client:load />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="flex flex-col items-center justify-center p-6 text-center py-24">
      <div class="max-w-3xl space-y-6">
        <span class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-indigo-500/10 text-indigo-400 rounded-full border border-indigo-500/20">
          {t.badge}
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          {t.title}
        </h1>
        <p class="text-lg text-gray-500 dark:text-gray-400">
          {t.subtitle}
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="#projects" class="px-6 py-3 font-medium bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition shadow-lg shadow-indigo-500/25">
            {t.explore}
          </a>
          <a href="#contatti" class="px-6 py-3 font-medium bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-xl transition">
            {t.contact}
          </a>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <ProjectsSection t={t} client:load />

    <!-- CV & Skills Section -->
    <CvSection lang={currentLang} client:load />

    <!-- Web Agencies Section -->
    <section id="agenzie" class="py-20 px-6 max-w-7xl mx-auto border-t border-gray-100 dark:border-gray-800">
      <div class="bg-indigo-600 text-white rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-4 max-w-2xl">
          <span class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-white/20 text-white rounded-full">
            {t.agencySection.badge}
          </span>
          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">
            {t.agencySection.title}
          </h2>
          <p class="text-indigo-100 text-sm md:text-base">
            {t.agencySection.desc}
          </p>
        </div>
        <a href="#contatti" class="px-6 py-3 bg-white text-indigo-600 font-semibold rounded-xl shadow-md hover:bg-gray-100 transition whitespace-nowrap">
          {t.agencySection.cta}
        </a>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contatti" class="py-20 px-6 max-w-4xl mx-auto border-t border-gray-100 dark:border-gray-800 text-center space-y-8">
      <div class="space-y-4">
        <span class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-indigo-500/10 text-indigo-400 rounded-full border border-indigo-500/20">
          {t.contactSection.badge}
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          {t.contactSection.title}
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          {t.contactSection.desc}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto pt-4">
        <!-- Email -->
        <a 
          href="mailto:devlabsolutionstm888@gmail.com" 
          class="flex items-center justify-center gap-3 p-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:border-indigo-500 transition group md:col-span-2"
        >
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center group-hover:scale-110 transition">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div class="text-left">
            <span class="block text-xs text-gray-400">Email</span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">devlabsolutionstm888@gmail.com</span>
          </div>
        </a>

        <!-- Italia (Telefono + WhatsApp) -->
        <div class="flex flex-col gap-3 p-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm text-left">
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100 dark:border-gray-800">
            <span class="text-lg">🇮🇹</span>
            <span class="text-xs font-bold text-gray-900 dark:text-white uppercase tracking-wide">Italia</span>
          </div>
          <div class="flex items-center justify-between">
            <a href="tel:+393478101692" class="flex items-center gap-2 text-xs font-semibold text-gray-700 dark:text-gray-300 hover:text-indigo-500 transition">
              <i class="fa-solid fa-phone text-indigo-500"></i> +39 347 810 1692
            </a>
            <a href="https://wa.me/393478101692" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white text-xs font-semibold rounded-lg transition">
              <i class="fa-brands fa-whatsapp text-sm"></i> WhatsApp
            </a>
          </div>
        </div>

        <!-- Spagna (Telefono + WhatsApp) -->
        <div class="flex flex-col gap-3 p-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm text-left">
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100 dark:border-gray-800">
            <span class="text-lg">🇪🇸</span>
            <span class="text-xs font-bold text-gray-900 dark:text-white uppercase tracking-wide">Spagna</span>
          </div>
          <div class="flex items-center justify-between">
            <a href="tel:+34602708829" class="flex items-center gap-2 text-xs font-semibold text-gray-700 dark:text-gray-300 hover:text-indigo-500 transition">
              <i class="fa-solid fa-phone text-indigo-500"></i> +34 602 708 829
            </a>
            <a href="https://wa.me/34602708829" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500 hover:text-white text-xs font-semibold rounded-lg transition">
              <i class="fa-brands fa-whatsapp text-sm"></i> WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <ChatWidget lang={currentLang} client:load />
  </main>
</Layout>